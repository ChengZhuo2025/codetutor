# =============================================================================
# CodeTutor 环境变量配置
# 复制此文件为 .env.local 并填入实际值：cp .env.example .env.local
# 注意：不要将 .env.local 或任何包含真实密钥的文件提交到版本控制
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase（必填）
# 从 Supabase 项目 Settings > API 获取以下值
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase 服务端密钥，用于管理操作。不要在前端暴露
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 应用配置
# ---------------------------------------------------------------------------
# 应用部署地址，本地开发默认为 http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 管理员（必填，用于首次创建管理员账号）
# ---------------------------------------------------------------------------
# 管理员 API 密钥，用于后台管理认证
ADMIN_API_SECRET=

# ---------------------------------------------------------------------------
# 数据库连接（可选）
# 仅在使用外部 PostgreSQL 工具（如 psql）直接连接时需要
# Supabase 客户端连接不需要这些，使用上方的 Supabase 变量即可
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSLMODE=require

# ---------------------------------------------------------------------------
# 开发环境（可选）
# ---------------------------------------------------------------------------
# 本地开发时用于跳过某些认证步骤的用户 ID
DEV_SUPABASE_USER_ID=
DEV_DEFAULT_USER_ID=

# ---------------------------------------------------------------------------
# AI Provider（必填）
# ---------------------------------------------------------------------------
# Provider API Key 加密密钥，用于加密存储第三方 AI 服务密钥
# 生成方式：openssl rand -hex 32
AI_PROVIDER_SECRET_ENCRYPTION_KEY=
# 硅基流动（SiliconFlow）API Key，用于默认 AI 对话
SILICONFLOW_API_KEY=

# ---------------------------------------------------------------------------
# 学习材料异步处理（可选 / 实验性功能开关）
# ---------------------------------------------------------------------------
# 是否启用异步材料规划生成
MATERIAL_PLAN_ASYNC_ENABLED=
# 是否允许从平台源（B站、YouTube 等）抓取材料
MATERIAL_PLAN_PLATFORM_SOURCES_ENABLED=
# 语音识别（ASR）模型代码
MATERIAL_PLAN_ASR_MODEL_CODE=
# 图片识别（Vision）模型代码
MATERIAL_PLAN_VISION_MODEL_CODE=
# 学习材料质量评估模型代码
MATERIAL_PLAN_QUALITY_MODEL_CODE=
